# ApplyTrack Environment Variables Template
# Copy this file to .env and supply your local or production values.
# NEVER commit real credentials or secrets to version control.

# Application Environment
NODE_ENV=development
PORT=5000

# Database Configuration
# In local development, if left blank, ApplyTrack automatically falls back
# to an embedded in-memory MongoDB instance for zero-friction setup.
# In production, provide your MongoDB Atlas connection URI:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/applytrack?retryWrites=true&w=majority

# Authentication & Session Security
JWT_SECRET=replace_with_a_long_random_entropy_secret_key_32_plus_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_signing_secret_key

# Cross-Origin Resource Sharing (CORS)
# Set to your deployed frontend domain in production (e.g., https://applytrack.onrender.com)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
