# ApplyTrack Server Environment Variables
NODE_ENV=development
PORT=5000
MONGODB_URI=
JWT_SECRET=replace_with_a_long_random_entropy_secret_key_32_plus_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_signing_secret_key
